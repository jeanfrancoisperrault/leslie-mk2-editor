{
  "name": "leslie-2101mk2-editor",
  "private": true,
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "description": "Desktop-first web editor for the Leslie 2101 mk2 and 2103 mk2 rotary speakers (Web MIDI, NRPN + SysEx)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
